<?xml version="1.0" encoding="UTF-8"?>
<experiment boot="kollaps:2.0">
  <services>
    <service name="dashboard" image="kollaps/dashboard:1.0" supervisor="true" port="8088"/>
    <service name="timelord" image="chia-private:local" command="['timelord', 'timelord']"/>
    <service name="farmer-1" image="chia-private:local" command="['farmer', 'farmer-1']"/>
    <service name="farmer-2" image="chia-private:local" command="['farmer', 'farmer-2']"/>
    <service name="farmer-3" image="chia-private:local" command="['farmer', 'farmer-3']"/>
    <service name="farmer-4" image="chia-private:local" command="['farmer', 'farmer-4']" />
    <service name="full-node-1" image="chia-private:local" command="['full_node', 'full-node-1']" />
    <service name="full-node-2" image="chia-private:local" command="['full_node', 'full-node-2']" />
  </services>
  <bridges>
    <bridge name="switch"/>
  </bridges>
  <links>
    <!-- Each node-to-node path traverses two 5 ms links: 10 ms one-way. -->
    <link origin="timelord" dest="switch" latency="5" upload="1Mbps" download="1Mbps" network="kollaps_network"/>
    <link origin="farmer-1" dest="switch" latency="5" upload="1Mbps" download="1Mbps" network="kollaps_network"/>
    <link origin="farmer-2" dest="switch" latency="5" upload="1Mbps" download="1Mbps" network="kollaps_network"/>
    <link origin="farmer-3" dest="switch" latency="5" upload="1Mbps" download="1Mbps" network="kollaps_network"/>
    <link origin="farmer-4" dest="switch" latency="5" upload="1Mbps" download="1Mbps" network="kollaps_network" />
    <link origin="full-node-1" dest="switch" latency="5" upload="1Mbps" download="1Mbps" network="kollaps_network" />
    <link origin="full-node-2" dest="switch" latency="5" upload="1Mbps" download="1Mbps" network="kollaps_network" />
  </links>
</experiment>
